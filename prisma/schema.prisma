generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(editor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id            String       @id @default(uuid())
  slug          String       @unique
  titleFr       String
  titleEn       String
  descriptionFr String
  descriptionEn String
  startsAt      DateTime
  endsAt        DateTime?
  location      String       @default("Rclub Strasbourg")
  coverImageUrl String
  heroVideoUrl  String?
  ticketUrl     String?
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  medias        EventMedia[]
}

model EventMedia {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url        String
  type       MediaType @default(photo)
  captionFr  String?
  captionEn  String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model ReservationRequest {
  id             String                   @id @default(uuid())
  fullName       String
  email          String
  phone          String
  eventId        String?
  dateRequested  DateTime?
  guestCount     Int
  message        String?
  status         ReservationRequestStatus @default(new)
  sourceLocale   String
  consentRgpd    Boolean
  adminNotes     String?
  notifiedAt     DateTime?
  confirmedAt    DateTime?
  refusedAt      DateTime?
  cancelledAt    DateTime?
  createdByAdmin Boolean                  @default(false)
  arrivalTime    String?
  tableType      String?
  occasionType   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model PrivatizationRequest {
  id           String                   @id @default(uuid())
  fullName     String
  email        String
  phone        String
  eventDate    DateTime?
  guestCount   Int
  budgetRange  String?
  eventType    String?
  message      String?
  status       ReservationRequestStatus @default(new)
  sourceLocale String
  consentRgpd  Boolean
  createdAt    DateTime                 @default(now())
}

model SiteAsset {
  id        String       @id @default(uuid())
  key       SiteAssetKey
  value     String
  locale    String       @default("global")
  updatedAt DateTime     @updatedAt
}

enum ReservationRequestStatus {
  new
  confirmed
  refused
  cancelled
}

enum Role {
  super_admin
  editor
}

enum MediaType {
  photo
  video
}

enum SiteAssetKey {
  logo
  home_hero_video
  home_hero_poster
  reservation_notify_emails
}
