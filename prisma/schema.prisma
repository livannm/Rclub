generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(editor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleFr       String
  titleEn       String
  descriptionFr String
  descriptionEn String
  startsAt      DateTime
  endsAt        DateTime?
  location      String   @default("Rclub Strasbourg")
  coverImageUrl String
  heroVideoUrl  String?
  ticketUrl     String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReservationRequest {
  id           String                    @id @default(uuid())
  fullName     String
  email        String
  phone        String
  eventId      String?
  dateRequested DateTime?
  guestCount   Int
  message      String?
  status       ReservationRequestStatus  @default(new)
  sourceLocale String
  consentRgpd  Boolean
  createdAt    DateTime                  @default(now())
}

model PrivatizationRequest {
  id           String                   @id @default(uuid())
  fullName     String
  email        String
  phone        String
  eventDate    DateTime?
  guestCount   Int
  budgetRange  String?
  message      String?
  status       ReservationRequestStatus @default(new)
  sourceLocale String
  consentRgpd  Boolean
  createdAt    DateTime                 @default(now())
}

enum ReservationRequestStatus {
  new
  reviewed
  contacted
  closed
}

enum Role {
  super_admin
  editor
}
