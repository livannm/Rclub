# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL local ou Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Apres configuration: pnpm db:setup  (schema + donnees de demo)

# Auth (si NextAuth est utilise)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
ADMIN_EMAIL=adminRclub
ADMIN_PASSWORD=strasbourgRClub

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@your-domain.com
RESEND_CONTACT_TO=contact@your-domain.com

# Firebase Cloud Storage (upload media depuis l'admin, SDK client). Si non
# renseigne (ou valeurs placeholder ci-dessous), les uploads basculent
# automatiquement sur le stockage local de dev (public/media/uploads).
#
# Mise en place :
# 1. Creer un projet Firebase et activer Storage
# 2. Project Settings > General > Your apps > Web app : copier le firebaseConfig
# 3. Reporter les valeurs ci-dessous
# 4. Storage > Rules : autoriser l'ecriture (l'upload se fait cote serveur)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
# Bucket: visible dans la console Firebase Storage (ex. mon-projet.appspot.com
# ou mon-projet.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Optional media base (phase locale -> cloud)
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# Contact footer (optionnel)
NEXT_PUBLIC_CLUB_INSTAGRAM_URL=https://www.instagram.com/rclubstrasbourg
NEXT_PUBLIC_CLUB_PHONE=+33 3 88 24 00 00
NEXT_PUBLIC_CLUB_PHONE_HREF=tel:+33388240000
NEXT_PUBLIC_CLUB_ADDRESS=24 place des halles, 67000 Strasbourg
