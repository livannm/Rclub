# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL local ou Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Apres configuration: pnpm db:setup  (schema + donnees de demo)

# Auth (si NextAuth est utilise)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_long_random_secret
ADMIN_EMAIL=adminRclub
ADMIN_PASSWORD=strasbourgRClub

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@your-domain.com
RESEND_CONTACT_TO=contact@your-domain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional media base (phase locale -> cloud)
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# Contact footer (optionnel)
NEXT_PUBLIC_CLUB_INSTAGRAM_URL=https://www.instagram.com/rclubstrasbourg
NEXT_PUBLIC_CLUB_PHONE=+33 3 88 24 00 00
NEXT_PUBLIC_CLUB_PHONE_HREF=tel:+33388240000
NEXT_PUBLIC_CLUB_ADDRESS=24 place des halles, 67000 Strasbourg
