# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL local ou Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Apres configuration: pnpm db:setup  (schema + donnees de demo)

# Auth (NextAuth — login admin via variables d'environnement, pas la base de donnees)
#
# Vercel — portee par environnement :
#   Production  : AUTH_URL=https://r-club.fr  (domaine final uniquement)
#   Preview     : ne PAS definir AUTH_URL — trustHost detecte l'URL *.vercel.app
#   Tous        : AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD (Runtime)
#
# Tant que le site n'a pas son domaine final, les previews changent d'URL a chaque
# deploiement : c'est normal. Laissez AUTH_URL vide en Preview.
AUTH_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Production seulement (optionnel en local/preview si trustHost est actif) :
# AUTH_URL=https://r-club.fr
# Aliases supportes : NEXTAUTH_SECRET, NEXTAUTH_URL
# Comptes admin stockes en base (table AdminUser). Au seed, ADMIN_EMAIL/PASSWORD
# creent le premier super_admin. Ensuite, les super admins peuvent creer d'autres
# comptes depuis /admin/users.
ADMIN_EMAIL=adminRclub
ADMIN_PASSWORD=strasbourgRClub

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@your-domain.com
RESEND_CONTACT_TO=contact@your-domain.com
# Fallback si la liste admin est vide (voir /admin/reservations/notifications)

# Firebase Cloud Storage (upload media depuis l'admin, SDK client). Si non
# renseigne (ou valeurs placeholder ci-dessous), les uploads basculent
# automatiquement sur le stockage local de dev (public/media/uploads).
#
# Mise en place :
# 1. Creer un projet Firebase et activer Storage
# 2. Project Settings > General > Your apps > Web app : copier le firebaseConfig
# 3. Reporter les valeurs ci-dessous
# 4. Storage > Rules : autoriser l'ecriture (l'upload se fait cote serveur)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
# Bucket: visible dans la console Firebase Storage (ex. mon-projet.appspot.com
# ou mon-projet.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Optional media base (phase locale -> cloud)
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# Contact footer (optionnel)
NEXT_PUBLIC_CLUB_INSTAGRAM_URL=https://www.instagram.com/rclubstrasbourg
NEXT_PUBLIC_CLUB_PHONE=+33 3 88 24 00 00
NEXT_PUBLIC_CLUB_PHONE_HREF=tel:+33388240000
NEXT_PUBLIC_CLUB_ADDRESS=24 place des halles, 67000 Strasbourg
